+  Expect<void> dumpMemType(std::string filename) {
+    // Open file
+    filename = filename + "mem_page_count.img";
+    // filename = filename + "_memtype.img";
+    uint32_t CurPageCount = MemType.getLimit().getMin();
+
+    std::ofstream fout;
